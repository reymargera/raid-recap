# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
src/__generated__/

# misc
.DS_Store
*.pem
*.idea
.vscode

# python (scripts/)
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.development
.dev.vars

# wrangler
.wrangler/
wrangler-state/
cloudflare-env.d.ts
worker-configuration.d.ts
/.open-next

# local data storage
/data/

# wow.export game data dumps (see wow-exports/README.md) - large, regenerated each season, never committed
/wow-exports/*
!/wow-exports/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
