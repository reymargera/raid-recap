{
  "name": "raid-recap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "graphql-codegen",
    "dev": "next dev",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --minify && opennextjs-cloudflare deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build": "npm run generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:init": "wrangler d1 execute raid-recap-db --local --file=./schemas/schema.sql",
    "db:query": "wrangler d1 execute raid-recap-db --local --command",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@apollo/client": "^3.10.8",
    "better-auth": "^1.4.10",
    "bottleneck": "^2.19.5",
    "chart.js": "^4.4.3",
    "next": "~16.0.10",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "swiper": "^11.1.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/client-preset": "^4.3.2",
    "@opennextjs/cloudflare": "^1.14.7",
    "@types/graphql": "^14.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "ioredis": "^5.8.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8",
    "redis": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5",
    "wrangler": "^4.51.0",
    "zod": "^4.1.13"
  }
}
